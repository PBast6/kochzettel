{
  "configs": {
    "Debug": "debug",
    "Release": "release"
  },
  "name": "Kochzettel",
  "options": {
    "groupSortPosition": "bottom",
    "transitivelyLinkDependencies": false
  },
  "settings": {
    "CODE_SIGN_IDENTITY": "-"
  },
  "targets": {
    "Kochzettel": {
      "dependencies": [
        {
          "embed": true,
          "target": "Kochzettel Watch"
        }
      ],
      "deploymentTarget": "26.0",
      "info": {
        "path": "App/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Kochzettel",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "UILaunchScreen": {},
          "UISupportedInterfaceOrientations": [
            "UIInterfaceOrientationPortrait",
            "UIInterfaceOrientationPortraitUpsideDown",
            "UIInterfaceOrientationLandscapeLeft",
            "UIInterfaceOrientationLandscapeRight"
          ]
        }
      },
      "platform": "auto",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.b3585d4a-d52d-4f31-8f66-bc789a1191ac",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2"
      },
      "sources": [
        {
          "path": "App"
        }
      ],
      "supportedDestinations": [
        "iOS",
        "macOS"
      ],
      "type": "application"
    },
    "Kochzettel Watch": {
      "deploymentTarget": "26.0",
      "info": {
        "path": "Watch/Info.plist",
        "properties": {
          "CFBundleDisplayName": "Kochzettel",
          "CFBundleShortVersionString": "1.0",
          "CFBundleVersion": "1",
          "ITSAppUsesNonExemptEncryption": false,
          "WKApplication": true,
          "WKCompanionAppBundleIdentifier": "app.bitrig.new.b3585d4a-d52d-4f31-8f66-bc789a1191ac"
        }
      },
      "platform": "watchOS",
      "settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CURRENT_PROJECT_VERSION": "1",
        "MARKETING_VERSION": "1.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.bitrig.new.b3585d4a-d52d-4f31-8f66-bc789a1191ac.watchkitapp",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SWIFT_VERSION": "5.0"
      },
      "sources": [
        {
          "path": "Watch"
        },
        {
          "path": "App/Assets.xcassets"
        }
      ],
      "type": "application"
    }
  }
}
